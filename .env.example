# Copy to .env and adjust. Read by docker compose (env_file) at container start.

# Seconds between two collections.
POLL_INTERVAL_SECONDS=60

# Location to monitor (default: Cluj-Napoca).
LATITUDE=46.7712
LONGITUDE=23.6236

# Open-Meteo air quality endpoint and per-request timeout.
OPEN_METEO_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality
REQUEST_TIMEOUT_SECONDS=10

# Output file names inside the data volume. Both are overwritten on every poll.
JSON_FILENAME=air_quality.json
XML_FILENAME=air_quality.xml

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
